{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "renerpdev-portfolio",
  "account_id": "ec3673cd92f59b7153203f1b3da7982a",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "portfolio.renerp.dev", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/contact",
      "/api/contact/",
      "/api/mailrelay/subscribe",
      "/api/mailrelay/subscribe/",
      "/studio/*",
      "!/studio/static/*"
    ]
  },
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMITER", "namespace_id": "26112701", "simple": { "limit": 5, "period": 60 } }
  ],
  "secrets": {
    "required": ["RESEND_API_KEY", "EMAIL_RECIPIENT", "WEBHOOK_KEY", "MAIL_RELAY_API_KEY", "MAIL_RELAY_API_URL"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
