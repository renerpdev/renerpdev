{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "dev:studio": "node --env-file-if-exists=.env.local scripts/run-studio.mjs dev --port 3003",
    "build": "next build && node --env-file-if-exists=.env.local scripts/run-studio.mjs build && node scripts/build-resume.mjs",
    "build:studio": "node --env-file-if-exists=.env.local scripts/run-studio.mjs build",
    "build:resume": "node scripts/build-resume.mjs",
    "check:worker": "wrangler types worker/env.d.ts && tsc -p worker/tsconfig.json",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --no-warnings --experimental-strip-types --test sanity/lib/*.test.mjs worker/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write --list-different .",
    "migrate:testimonial-profile-images": "node --no-warnings --experimental-strip-types scripts/migrate-testimonial-profile-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/ubuntu": "5.3.0",
    "@portabletext/react": "^4.0.3",
    "@react-hook/mouse-position": "^4.1.3",
    "@sanity/client": "7.15.0",
    "@sanity/icons": "3.7.4",
    "@sanity/vision": "^4.22.0",
    "date-fns": "4.1.0",
    "framer-motion": "^12.23.24",
    "groq": "4.22.0",
    "lenis": "^1.3.11",
    "next": "15.5.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^4.22.0",
    "sharp": "^0.34.4",
    "styled-components": "^6.1.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"],
    "overrides": {
      "minimatch@>=5 <10.2.1": "10.2.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "ajv@<6.14.0": ">=6.14.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-26996"
      ]
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.38.0",
    "@sparticuz/chromium": "^143.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-validate-filename": "^0.0.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "puppeteer-core": "^24.37.5",
    "serve-handler": "6.1.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "4.161.0"
  }
}
